# Gemini API Credentials & Model
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_LIVE_MODEL=gemini-3.8-live
GEMINI_SUMMARY_MODEL=gemini-2.5-flash

# Plivo outbound calls (see docs/PLIVO_SETUP.md)
OUTBOUND_CALLS_ENABLED=false
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
PLIVO_FROM_NUMBER=
# Caller-ID pool for concurrent calls (overrides PLIVO_FROM_NUMBER), comma separated.
PLIVO_FROM_NUMBERS=
PLIVO_ORGANIZATION_ID=
PLIVO_ALLOWED_COUNTRIES=IN
# Generate once: uv run python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
MEDIA_GRANT_ENCRYPTION_KEY=
CALL_MAX_DURATION_SECONDS=600
CALL_ANSWER_TIMEOUT_SECONDS=45
CALL_GREETING_PREPARE_TIMEOUT_SECONDS=10
MEDIA_START_TIMEOUT_SECONDS=10
MEDIA_IDLE_TIMEOUT_SECONDS=30
MEDIA_GRANT_TTL_SECONDS=300
# Concurrent calls = min(TELEPHONY_MAX_CONCURRENT_CALLS, numbers x TELEPHONY_CALLS_PER_NUMBER).
TELEPHONY_MAX_CONCURRENT_CALLS=30
TELEPHONY_CALLS_PER_NUMBER=1
TELEPHONY_DIALS_PER_SECOND=1
TELEPHONY_HOURLY_CALL_LIMIT=200
# Hang up this long after the agent calls end_call if Plivo never confirms the goodbye played.
CALL_HANGUP_GRACE_SECONDS=12

# Public Server URL (e.g. ngrok HTTPS base URL)
PUBLIC_BASE_URL=https://xxxx.ngrok-free.app

# Greeting & System Instructions (Optional overrides; defaults to app.gemini.agent_prompt)
# INITIAL_GREETING=  (optional override; default script lives in app/gemini/agent_prompt.py)

# Local SQLite file (no database server). Blank DATABASE_URL disables the database;
# omit the line to use the default be/data/ai_sales.db. Tables are created on startup.
DATABASE_URL=sqlite+aiosqlite:///./data/ai_sales.db
# Optional PostgreSQL instead (see docs/SUPABASE_SETUP.md): postgresql://... URLs + Alembic.
MIGRATION_DATABASE_URL=
# Raw password for URLs without an embedded password; no URL encoding needed.
DATABASE_PASSWORD=
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=0
DB_POOL_TIMEOUT_SECONDS=10
DB_CONNECT_TIMEOUT_SECONDS=10
# Bound network waits even if the server cannot deliver its statement timeout.
DB_IO_TIMEOUT_SECONDS=20
DB_POOL_RECYCLE_SECONDS=300
DB_STATEMENT_TIMEOUT_MS=15000
DB_SSLMODE=verify-full
# Absolute path to the root CA downloaded from Supabase Database settings.
# Blank uses the system trust store (appropriate when the endpoint CA is trusted).
DB_SSLROOTCERT=

# Private Meta Embedded Signup prototype. Leave disabled until configured.
WHATSAPP_PROTOTYPE_ENABLED=false
META_APP_ID=
META_APP_SECRET=
META_EMBEDDED_SIGNUP_CONFIG_ID=
# Supported Graph API version selected in your Meta app, e.g. vNN.0.
META_GRAPH_API_VERSION=
META_WEBHOOK_VERIFY_TOKEN=
# Generate once with: uv run python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
# Keep this key stable: it encrypts saved tokens and prototype sessions.
WHATSAPP_ENCRYPTION_KEY=
# Exact frontend origins, comma separated, no paths or trailing slashes.
WHATSAPP_ALLOWED_ORIGINS=https://your-private-pilot.example.com
# false is allowed ONLY for http://localhost or http://127.0.0.1 development.
WHATSAPP_COOKIE_SECURE=true

# Firebase identity and organization access (mandatory for application APIs)
APP_ENV=development
FIREBASE_PROJECT_ID=
# Realtime Database holding organizations, users, memberships and invitations.
FIREBASE_DATABASE_URL=
# Set true if Firebase requests stall ~60s (IPv6 advertised but unreachable).
NETWORK_IPV4_ONLY=false
AUTH_HTTP_TIMEOUT_SECONDS=10
# Use workload identity/ADC in deployment, or a local ignored service account file:
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/outside/repository/firebase-admin.json
# Development emulator ONLY (must match frontend emulator configuration):
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
AUTH_REQUIRE_ADMIN_MFA=false
APP_FRONTEND_URL=http://localhost:5173/ui/
# Generate using: python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
AUTH_OUTBOX_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true

# Optional backend-only lead/call export to the deployed Apps Script v3.
GOOGLE_SHEETS_ENABLED=false
GOOGLE_SHEETS_WEB_APP_URL=
GOOGLE_SHEETS_ACCESS_CODE=
# Internal scope only; Organization ID is never exported to the sheet.
GOOGLE_SHEETS_ORGANIZATION_ID=
GOOGLE_SHEETS_SYNC_INTERVAL_SECONDS=15
