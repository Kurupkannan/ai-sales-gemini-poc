# Gemini API Credentials & Model
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_LIVE_MODEL=gemini-3.8-live

# Exotel Credentials & Settings
EXOTEL_API_KEY=live_key
EXOTEL_API_TOKEN=key
EXOTEL_ACCOUNT_SID=id
EXOTEL_EXOPHONE=phone
EXOTEL_REGION=region

# Public Server URL (e.g. ngrok HTTPS base URL)
PUBLIC_BASE_URL=https://xxxx.ngrok-free.app

# Greeting & System Instructions (Optional overrides; defaults to app.gemini.agent_prompt)
INITIAL_GREETING=ഞാൻ Trade Max Academy-യിൽ നിന്നാണ് വിളിക്കുന്നത്. ഒരു 2 മിനിറ്റ് സംസാരിക്കാൻ ഫ്രീ ആയിരിക്കുമോ?

# Supabase PostgreSQL: see docs/SUPABASE_SETUP.md. Leave blank until configured.
# Both URLs can use your existing postgres account; one shared password below.
DATABASE_URL=
MIGRATION_DATABASE_URL=
# Raw password for URLs without an embedded password; no URL encoding needed.
DATABASE_PASSWORD=
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=0
DB_POOL_TIMEOUT_SECONDS=10
DB_CONNECT_TIMEOUT_SECONDS=10
DB_STATEMENT_TIMEOUT_MS=15000
DB_SSLMODE=verify-full
# Absolute path to the root CA downloaded from Supabase Database settings.
# Blank uses the system trust store (appropriate when the endpoint CA is trusted).
DB_SSLROOTCERT=
